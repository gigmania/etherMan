{
  "name": "etherman",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run contracts:build && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "node tools/foundry.mjs forge test",
    "test:integration": "node tools/integration.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:contracts && npm run test:integration",
    "contracts:build": "node tools/compile.mjs",
    "chain": "node tools/foundry.mjs anvil --host 127.0.0.1 --chain-id 31337",
    "chain:scroll": "node tools/foundry.mjs anvil --host 127.0.0.1 --chain-id 31337 --fork-url https://rpc.scroll.io",
    "deploy:local": "npm run contracts:build && node tools/deploy-local.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.16",
    "wagmi": "3.7.11"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "solc": "0.8.38",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
